generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────

enum Role {
  MASTER
  PLAYER
}

enum BaseRank {
  E
  D
  C
  B
  A
  S
}

enum RacePath {
  ASCENSAO
  CORRUPCAO
  PERMANENCIA
}

enum SpecialCardType {
  VALETE
  CAVALEIRO
}

enum ReadingType {
  COMUM
  PROFUNDA
}

// ─── AUTH ─────────────────────────────────────────────────

model User {
  id                  String                        @id @default(cuid())
  email               String                        @unique
  username            String?
  avatar              String?
  avatarCrop          String?
  bio                 String?
  preferences         Json?
  notifications       Json?
  createdAt           DateTime                      @default(now())
  passwordHash        String?
  accounts            Account[]
  sessions            Session[]
  memberships         CampaignMember[]
  inboxNotifications  Notification[]
  explorationPresence CampaignExplorationPresence[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CAMPANHA ─────────────────────────────────────────────

model Campaign {
  id                     String                        @id @default(cuid())
  name                   String
  description            String?
  inviteCode             String                        @unique @default(cuid())
  masterId               String
  isActive               Boolean                       @default(false)
  archived               Boolean                       @default(false)
  archivedAt             DateTime?
  createdAt              DateTime                      @default(now())
  members                CampaignMember[]
  worlds                 World[]
  characters             Character[]
  items                  InventoryItem[]
  explorationMaps        ExplorationMap[]
  explorationState       CampaignExplorationState?
  explorationDiscoveries ExplorationDiscovery[]
  explorationPresence    CampaignExplorationPresence[]
  conditionDefinitions   CampaignConditionDefinition[]
  mapMissionProgress     MapMissionProgress[]
  atlasDiscoveries       AtlasDiscovery[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  role       Role     @default(PLAYER)
  active     Boolean  @default(false)
  joinedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model ExplorationMap {
  id              String                 @id
  campaignId      String
  name            String
  rooms           Json                   @default("[]")
  floors          Json                   @default("[{\"id\":\"ground\",\"name\":\"Térreo\"}]")
  isEditing       Boolean                @default(true)
  isPublished     Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  discoveries     ExplorationDiscovery[]
  missionProgress MapMissionProgress[]

  @@index([campaignId])
}

model CampaignExplorationState {
  campaignId        String   @id
  currentMapId      String?
  currentRoomId     String?
  discovered        Json     @default("[]")
  activeInteraction Json?
  updatedAt         DateTime @updatedAt
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignExplorationPresence {
  campaignId  String
  userId      String
  mapId       String
  roomId      String
  characterId String?
  updatedAt   DateTime   @default(now())
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([campaignId, userId])
  @@index([campaignId, mapId, roomId, updatedAt])
}

model ExplorationDiscovery {
  campaignId      String
  mapId           String
  objectId        String
  type            String
  title           String
  inventoryItemId String?
  itemName        String?
  foundByUserId   String?
  characterId     String?
  createdAt       DateTime       @default(now())
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  map             ExplorationMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([campaignId, mapId, objectId])
  @@index([campaignId, createdAt])
}

model MapMissionProgress {
  campaignId  String
  mapId       String
  missionId   String
  characterId String
  acceptedAt  DateTime       @default(now())
  completedAt DateTime?
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  map         ExplorationMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([campaignId, mapId, missionId, characterId])
  @@index([campaignId, characterId])
}

// ─── MUNDO ────────────────────────────────────────────────

model World {
  id          String    @id @default(cuid())
  slug        String
  name        String
  description String?
  coverColor  String?
  coverImage  String?
  pageColor   String    @default("#f7f3e9")
  pageTexture Boolean   @default(true)
  pageHeader  String    @default("")
  pageFooter  String    @default("")
  isLocked    Boolean   @default(true)
  isDraft     Boolean   @default(false)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  chapters    Chapter[]

  @@unique([slug, campaignId])
}

model Chapter {
  id      String @id @default(cuid())
  title   String
  content String @db.Text
  order   Int
  worldId String
  world   World  @relation(fields: [worldId], references: [id])
}

// ─── UNIVERSO / RAÇA ──────────────────────────────────────

model Universe {
  id                  String               @id @default(cuid())
  name                String               @unique
  description         String               @default("") @db.Text
  artworkUrl          String?
  artStyle            String               @default("")
  kind                String               @default("universe") // origin | universe | multiversal
  visibility          String               @default("PUBLIC")
  worlds              UniverseWorld[]
  outgoingConnections UniverseConnection[] @relation("UniverseConnectionFrom")
  incomingConnections UniverseConnection[] @relation("UniverseConnectionTo")
}

model UniverseConnection {
  id             String   @id @default(cuid())
  fromUniverseId String
  toUniverseId   String
  relationType   String   @default("known") // known | uncertain | multiversal
  description    String   @default("") @db.Text
  visibility     String   @default("PUBLIC")
  fromUniverse   Universe @relation("UniverseConnectionFrom", fields: [fromUniverseId], references: [id], onDelete: Cascade)
  toUniverse     Universe @relation("UniverseConnectionTo", fields: [toUniverseId], references: [id], onDelete: Cascade)

  @@unique([fromUniverseId, toUniverseId])
}

model AtlasDiscovery {
  id           String   @id @default(cuid())
  campaignId   String
  entityType   String
  entityId     String
  discoveredAt DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, entityType, entityId])
  @@index([campaignId, entityType])
}

model UniverseWorld {
  id          String   @id @default(cuid())
  name        String
  description String   @default("") @db.Text
  imageUrl    String?
  visibility  String   @default("PUBLIC")
  universeId  String
  universe    Universe @relation(fields: [universeId], references: [id])
  races       Race[]

  @@unique([name, universeId])
}

model Race {
  id              String          @id @default(cuid())
  name            String
  element         String
  baseRank        BaseRank        @default(D)
  isCorrupted     Boolean         @default(false)
  description     String?         @db.Text
  appearance      String          @default("") @db.Text
  biology         String          @default("") @db.Text
  culture         String          @default("") @db.Text
  masterNotes     String          @default("") @db.Text
  visibility      String          @default("PUBLIC")
  image           String?
  canAscend       Boolean         @default(false)
  canCorrupt      Boolean         @default(false)
  universeWorldId String
  universeWorld   UniverseWorld   @relation(fields: [universeWorldId], references: [id])
  characters      Character[]
  skills          RaceSkill[]
  evolutions      RaceEvolution[] @relation("FromRace")

  @@unique([name, universeWorldId])
}

// habilidades inatas de cada raça
model RaceSkill {
  id              String               @id @default(cuid())
  raceId          String
  race            Race                 @relation(fields: [raceId], references: [id])
  name            String
  description     String               @db.Text
  branch          String // passiva | aprimoramento | ativa | reacao
  levelRequired   Int                  @default(1)
  maxLevel        Int                  @default(3)
  isInnate        Boolean              @default(true)
  element         String               @default("terra")
  costResource    String               @default("none")
  costAmount      Int                  @default(0)
  range           String               @default("Pessoal")
  duration        String               @default("")
  trigger         String               @default("")
  enhances        String               @default("")
  execution       String               @default("") @db.Text
  testAttribute   String               @default("")
  results         String               @default("") @db.Text
  potency         String               @default("")
  lineName        String               @default("")
  formNumber      Int                  @default(1)
  requiredRank    String               @default("D")
  evolvesTo       String               @default("")
  requirements    String               @default("") @db.Text
  interactions    String               @default("") @db.Text
  visibility      String               @default("PUBLIC")
  levelEffects    String[]             @default([])
  evolutionStages String               @default("[]") @db.Text
  characterSkills CharacterRaceSkill[]
}

model CharacterRaceSkill {
  id           String    @id @default(cuid())
  characterId  String
  raceSkillId  String
  currentLevel Int       @default(0)
  uses         Int       @default(0)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  raceSkill    RaceSkill @relation(fields: [raceSkillId], references: [id], onDelete: Cascade)

  @@unique([characterId, raceSkillId])
}

// para qual raça cada caminho de evolução leva
model RaceEvolution {
  id            String   @id @default(cuid())
  fromRaceId    String
  fromRace      Race     @relation("FromRace", fields: [fromRaceId], references: [id])
  toRaceName    String
  path          RacePath
  levelRequired Int      @default(100)
}

// ─── PERSONAGEM ───────────────────────────────────────────

model Character {
  id            String  @id @default(cuid())
  name          String
  category      String // aluno | professor | npc | monstro
  element       String
  image         String?
  portraitImage String?
  worldSlug     String
  isLocked      Boolean @default(true)
  campaignId    String
  playerId      String?

  // campos específicos por categoria (nullable)
  year        Int? // aluno
  subject     String? // professor
  occupation  String? // npc
  dangerLevel String? // monstro

  story String? @db.Text

  // progressão
  level                    Int     @default(1)
  xp                       Int     @default(0)
  maxXp                    Int     @default(100)
  unspentAttributePoints   Int     @default(0)
  specialCardUsedThisScene Boolean @default(false)
  rankLosses               Int     @default(0)

  // rank de nascença (vem da raça, nunca muda)
  // rank atual é calculado pelo level no código — não salvo no banco
  birthRank BaseRank @default(D)

  // caminho de evolução da raça (preenchido quando o jogador escolhe)
  racePath      RacePath? // null = ainda não escolheu
  evolvedRaceId String?

  // atributos (escala por rank: D 1–10 | C 4–45 | B 6–63 | A 8–81 | S 10–100)
  agilidade    Int @default(1)
  inteligencia Int @default(1)
  forca        Int @default(1)
  vigor        Int @default(1)
  sorte        Int @default(1)

  // PV = 10 + (vigor × 2) | PM = 10 + (inteligencia × 2) — cacheados
  pv       Int @default(12)
  pvMax    Int @default(12)
  pm       Int @default(12)
  pmMax    Int @default(12)
  currency Int @default(100) // em Estilhaços

  // relações
  raceId             String
  race               Race                 @relation(fields: [raceId], references: [id])
  campaign           Campaign             @relation(fields: [campaignId], references: [id])
  skills             Skill[]
  innateSkills       CharacterRaceSkill[]
  tarotDraws         TarotDraw[]
  specialCards       SpecialCard[]
  affinitiesGiven    CharacterAffinity[]  @relation("AffinitySource")
  affinitiesReceived CharacterAffinity[]  @relation("AffinityTarget")
  mapMissionProgress MapMissionProgress[]

  conditions          CharacterCondition[]
  explorationPresence CampaignExplorationPresence[]

  @@index([campaignId, playerId])
}

model CharacterAffinity {
  campaignId        String
  sourceCharacterId String
  targetCharacterId String
  value             Int       @default(0)
  sessionChange     Int       @default(0)
  source            Character @relation("AffinitySource", fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  target            Character @relation("AffinityTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  @@id([campaignId, sourceCharacterId, targetCharacterId])
  @@index([campaignId, targetCharacterId])
}

model CharacterCondition {
  id          String    @id @default(cuid())
  characterId String
  type        String // "envenenado" | "exausto" | etc.
  appliedAt   DateTime  @default(now())
  removedAt   DateTime?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CampaignConditionDefinition {
  id                  String   @id @default(cuid())
  campaignId          String
  name                String
  cause               String   @db.Text
  color               String   @default("#D8B35E")
  removalInstructions String   @db.Text
  createdAt           DateTime @default(now())
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, name])
  @@index([campaignId])
}

// ─── HABILIDADES ──────────────────────────────────────────

model Skill {
  id                     String    @id @default(cuid())
  name                   String
  description            String
  branch                 String // ativa | passiva | reacao | aprimoramento
  element                String
  currentLevel           Int       @default(0)
  maxLevel               Int       @default(3)
  isUnlocked             Boolean   @default(false)
  requiredCharacterLevel Int
  uses                   Int       @default(0)
  levelEffects           String[]  @default([])
  evolutionStages        String    @default("[]") @db.Text
  costResource           String    @default("none")
  costAmount             Int       @default(0)
  range                  String    @default("Pessoal")
  duration               String    @default("")
  trigger                String    @default("")
  enhances               String    @default("")
  execution              String    @default("") @db.Text
  testAttribute          String    @default("")
  results                String    @default("") @db.Text
  potency                String    @default("")
  lineName               String    @default("")
  formNumber             Int       @default(1)
  requiredRank           String    @default("D")
  evolvesTo              String    @default("")
  requirements           String    @default("") @db.Text
  interactions           String    @default("") @db.Text
  characterId            String
  character              Character @relation(fields: [characterId], references: [id])
}

// ─── CARTAS ESPECIAIS ─────────────────────────────────────

model SpecialCard {
  id          String          @id @default(cuid())
  characterId String
  cardType    SpecialCardType
  isAvailable Boolean         @default(true)
  obtainedAt  DateTime        @default(now())
  usedAt      DateTime?
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // unicidade garantida via Server Action, não aqui
}

// ─── LEITURAS DE TARÔ ─────────────────────────────────────

model TarotDraw {
  id                   String      @id @default(cuid())
  readingType          ReadingType
  question             String      @db.Text
  cards                String[]
  sacrifice            String      @default("") @db.Text
  sacrificeIsPermanent Boolean     @default(false)
  hadJoker             Boolean     @default(false)
  drawnAt              DateTime    @default(now())
  characterId          String
  character            Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // ── campos para o fluxo de leitura em tempo real ──
  status              String  @default("pendente") // pendente | cartas_reveladas | concluida
  initiatedByMasterId String? // id do mestre que iniciou
}

// ─── INVENTÁRIO ───────────────────────────────────────────

model InventoryItem {
  id         String  @id @default(cuid())
  name       String
  slug       String
  category   String // equipamento | consumivel | material | reliquia | livro | outro
  rarity     String
  quantity   Int     @default(1)
  image      String?
  worldSlug  String?
  isLocked   Boolean @default(false)
  isDraft    Boolean @default(false)
  campaignId String
  ownerId    String?

  // campos específicos por tipo (nullable)
  forgedBy               String? // equipamento
  effect                 String? // equipamento | consumivel | reliquia
  equipmentType          String? // arma | armadura | escudo | outro
  equipmentSubtype       String? // subtipo de arma ou armadura
  equipmentEffects       Json? // efeitos com valores calculados pela raridade
  equipmentDurability    Int? // durabilidade atual; nulo para itens Míticos
  equipmentMaxDurability Int?
  origin                 String? // consumivel | material | reliquia | outro
  consumableType         String? // cura_pv | cura_pm | outro
  author                 String? // livro
  coverType              String? // livro: color | image
  coverColor             String? // livro
  coverImage             String? // livro
  pageColor              String  @default("#f7f3e9")
  pageTexture            Boolean @default(true)
  pageHeader             String  @default("")
  pageFooter             String  @default("")

  campaign Campaign      @relation(fields: [campaignId], references: [id])
  chapters ItemChapter[]

  @@unique([slug, campaignId])
  @@index([campaignId, ownerId])
}

model ItemChapter {
  id      String        @id @default(cuid())
  title   String
  content String        @db.Text
  order   Int
  itemId  String
  item    InventoryItem @relation(fields: [itemId], references: [id])
}

// Buckets de limite de tentativas compartilhados entre instâncias serverless.
model SecurityRateLimit {
  key             String    @id @db.VarChar(80)
  count           Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?

  @@index([windowStartedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
